			<UnwantedFiles Include="$(OutDir)Renci.SshNet.xml" />
			<UnwantedFiles Include="$(OutDir)CueSharp.xml" />
			<UnwantedFiles Include="$(OutDir)tiny7z.dll.config" />
			<UnwantedFiles Include="$(OutDir)data\licenses.tar" />
			<UnwantedFiles Include="$(OutDir)mods\hmods\hakchi.hmod" />
		</ItemGroup>
		<Delete Files="@(UnwantedFiles)" />
	</Target>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<!-- Copy GeneratedData/* into the output directory so hakchi.exe can find
                     tarballs, hmods, tools at runtime. Originally used busybox tar piped
                     through tar; rewritten to use MSBuild Copy task with recursive glob. -->
		<ItemGroup Condition="'$(Configuration)|$(Platform)'!='Dumper|AnyCPU' And Exists('$(SolutionDir)GeneratedData')">
			<GeneratedDataFiles Include="$(SolutionDir)GeneratedData/**/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(GeneratedDataFiles)"
			  DestinationFiles="$(OutDir)%(RecursiveDir)%(Filename)%(Extension)"
			  Condition="'@(GeneratedDataFiles)' != ''" />

		<ItemGroup Condition="'$(Configuration)|$(Platform)'=='Dumper|AnyCPU' And Exists('$(SolutionDir)GeneratedData')">
			<DumperFiles Include="$(SolutionDir)GeneratedData/basehmods.tar" />
			<DumperFiles Include="$(SolutionDir)driver/**/*.*" />
			<DumperFiles Include="$(SolutionDir)tools/arm/detached-fallback" />
		</ItemGroup>
		<Copy SourceFiles="@(DumperFiles)"
			  DestinationFiles="$(OutDir)%(RecursiveDir)%(Filename)%(Extension)"
			  Condition="'@(DumperFiles)' != ''" />
	</Target>

	<!-- PreBuild: generate build-metadata files consumed by Resources.resx.
             Previously this target shelled out to tools/busybox.exe with bash-style
             `cd /D` syntax, which failed silently on GitHub Actions windows-latest
             runner (busybox.exe exists but pwsh does not understand `cd /D`), so
             commit.txt was never created and the build failed with MSB3103.
             Rewritten to use native MSBuild tasks (MakeDir, WriteLinesToFile) and
             `git` invocations that work on every OS. -->
	<Target Name="PreBuild" BeforeTargets="PreBuildEvent">
		<MakeDir Directories="$(ProjectDir)ApiKeys" Condition="!Exists('$(ProjectDir)ApiKeys')" />
		<WriteLinesToFile File="$(ProjectDir)ApiKeys/TheGamesDB.txt" Lines="" Overwrite="false" Condition="!Exists('$(ProjectDir)ApiKeys/TheGamesDB.txt')" />
		<!-- Resources.resx references ..\apikeys\thegamesdb.txt (lowercase) — on case-sensitive
                     filesystems (Linux CI) we need to create the lowercase path too. On Windows
                     this is a no-op because the filesystem is case-insensitive. -->
		<MakeDir Directories="$(ProjectDir)apikeys" Condition="!Exists('$(ProjectDir)apikeys')" />
		<WriteLinesToFile File="$(ProjectDir)apikeys/thegamesdb.txt" Lines="" Overwrite="false" Condition="!Exists('$(ProjectDir)apikeys/thegamesdb.txt')" />

		<!-- commit.txt: short hash + -dirty suffix if working tree is dirty -->
		<Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitShortHash" />
		</Exec>
		<Exec Command="git diff-index --quiet HEAD --" IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="GitDirtyExitCode" />
		</Exec>
		<PropertyGroup Condition="'$(GitDirtyExitCode)' != '0' And '$(GitShortHash)' != ''">
			<GitShortHash>$(GitShortHash)-dirty</GitShortHash>
		</PropertyGroup>
		<WriteLinesToFile File="$(ProjectDir)commit.txt" Lines="$(GitShortHash)" />

		<!-- tag.txt: tag pointing exactly at HEAD, or empty -->
		<Exec Command="git describe --tags --exact-match" ConsoleToMSBuild="true" IgnoreExitCode="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
		</Exec>
		<WriteLinesToFile File="$(ProjectDir)tag.txt" Lines="$(GitTag)" />

		<!-- git-commits-since-last-tag.txt: log since the most recent tag -->
		<Exec Command="git log $(GitTag)..HEAD --oneline --no-decorate" ConsoleToMSBuild="true" IgnoreExitCode="true" Condition="'$(GitTag)' != ''">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitsSinceTag" />
		</Exec>
		<WriteLinesToFile File="$(ProjectDir)git-commits-since-last-tag.txt" Lines="$(GitCommitsSinceTag)" />

		<!-- Note: licenses.tar is created by ce-data.csproj PreBuild (it bundles
                     hakchi_gui/Licenses/*.txt into GeneratedData/data/licenses.tar).
                     hakchi_gui depends on ce-data via ProjectReference, so ce-data builds
                     first and licenses.tar is ready before hakchi_gui's CoreResGen runs. -->
	</Target>
