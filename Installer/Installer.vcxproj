	<PropertyGroup>
		<!-- 
      ИСПРАВЛЕНО: Скрипт переписан под .NET 8. 
      Убираем откат к net48, собираем в Release, ищем makensis через переменную PATH.
    -->
		<NMakeBuildCommandLine>
			msbuild.exe "$(SolutionDir)NSI\nsi-helper\nsi-helper.csproj" /p:Configuration=Release
			msbuild.exe "$(SolutionDir)Zipper\Zipper.csproj" /p:Configuration=Release

			if exist "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows" rmdir /S /Q "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows"

			msbuild.exe "$(SolutionPath)" /p:Configuration=Release /target:hakchi_gui

			"$(SolutionDir)NSI\nsi-helper\bin\Release\nsi-helper.exe" "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows" "$(SolutionDir)NSI\release-uninstall.nsh"

			makensis.exe "$(SolutionDir)NSI\Installer.nsi"

			del "$(SolutionDir)NSI\release-uninstall.nsh"
		</NMakeBuildCommandLine>
		<NMakeReBuildCommandLine>
			msbuild.exe "$(SolutionDir)NSI\nsi-helper\nsi-helper.csproj" /p:Configuration=Release /t:Rebuild
			msbuild.exe "$(SolutionDir)Zipper\Zipper.csproj" /p:Configuration=Release /t:Rebuild

			if exist "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows" rmdir /S /Q "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows"

			msbuild.exe "$(SolutionPath)" /p:Configuration=Release /target:hakchi_gui /t:Rebuild

			"$(SolutionDir)NSI\nsi-helper\bin\Release\nsi-helper.exe" "$(SolutionDir)hakchi_gui\bin\Release\net8.0-windows" "$(SolutionDir)NSI\release-uninstall.nsh"

			makensis.exe "$(SolutionDir)NSI\Installer.nsi"

			del "$(SolutionDir)NSI\release-uninstall.nsh"
		</NMakeReBuildCommandLine>
		<NMakePreprocessorDefinitions>WIN32;NDEBUG;$(NMakePreprocessorDefinitions)</NMakePreprocessorDefinitions>
		<!-- ОБНОВЛЕНО: Убрал захардкоженный путь к NSIS -->
		<NMakeCleanCommandLine>del "$(SolutionDir)hakchi_gui\bin\hakchi*-installer.exe"</NMakeCleanCommandLine>
		<ExecutablePath>$(VC_ExecutablePath_x86);$(WindowsSDK_ExecutablePath);$(VS_ExecutablePath);$(MSBuild_ExecutablePath);$(SystemRoot)\SysWow64;$(FxCopDir);$(PATH)</ExecutablePath>
